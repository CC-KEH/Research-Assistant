{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:default",
    "fs:default",
    "log:default",
    "opener:default",
    {
      "identifier": "fs:allow-read",
      "allow": [
        {
          "path": "$HOME/Documents/**"
        },
        {
          "path": "$DESKTOP/**"
        }
      ]
    }
  ],
  "scope": {
    "fs": {
      "allow": [
        "$HOME/**"
      ],
      "deny": [],
      "requireLiteralLeadingDot": false
    }
  }
}